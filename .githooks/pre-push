#!/bin/sh
# Refuses any push to main or master. main deploys to production, so every change goes through a
# pull request. Switched on by `npm install` (the "prepare" script sets core.hooksPath to .githooks).
# Git gives one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      branch="${remote_ref#refs/heads/}"
      {
        echo ""
        echo "  Push refused: never push to $branch."
        echo "  $branch deploys to production, so every change goes through a pull request."
        echo ""
        echo "  Put your commits on a branch and open a PR:"
        echo "    git switch -c fix/short-name    # moves your commits to a new branch"
        echo "    git push -u origin fix/short-name"
        echo "    gh pr create --base $branch"
        echo ""
      } >&2
      exit 1
      ;;
  esac
done
exit 0
