{
  "name": "kahanmilega",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:up": "docker compose up -d --build --wait",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m apps/api/migrations",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web",
    "test:unit": "vitest run --exclude \"**/*.int.test.ts\" --passWithNoTests",
    "test:integration": "vitest run int.test --passWithNoTests",
    "seed:catalog": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file-if-exists=.env apps/api/dist/seedCatalogMain.js",
    "simulate": "node apps/simulator/src/main.ts",
    "test:e2e": "npm run build -w @kahanmilega/shared -w @kahanmilega/api -w @kahanmilega/web && playwright test -c e2e/playwright.config.ts",
    "ai:models": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file=.env apps/api/dist/aiModelsMain.js",
    "ai:embed-catalog": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file-if-exists=.env apps/api/dist/aiEmbedCatalogMain.js",
    "eval:errand": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file-if-exists=.env apps/api/dist/evalErrandMain.js",
    "eval:resolve": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file-if-exists=.env apps/api/dist/evalResolveMain.js",
    "mcp:build": "npm run build -w @kahanmilega/shared -w @kahanmilega/mcp-server",
    "mcp:login": "npm run mcp:build --silent && node apps/mcp-server/dist/loginMain.js",
    "mcp:start": "npm run mcp:build --silent && node apps/mcp-server/dist/main.js",
    "errand:smoke": "npm run build -w @kahanmilega/shared -w @kahanmilega/api && node --env-file=.env apps/api/dist/errandSmokeMain.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai": false,
    "cpu-features": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "ssh2": false
  }
}
