            { "name": "resolve_item", "args": { "text": "sketch pens" } },
            { "name": "resolve_item", "args": { "text": "glue stick" } }
          ]
        },
        {
          "toolCalls": [
            { "name": "find_item_nearby", "args": { "itemId": "$item:{{kit}}" } },
            { "name": "find_item_nearby", "args": { "itemId": "$item:chart paper" } },
            { "name": "find_item_nearby", "args": { "itemId": "$item:crayons" } },
