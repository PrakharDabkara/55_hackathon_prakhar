{
  "note": "The scripted model for e2e/errand.spec.ts (LLM_PROVIDER=fake, FAKE_LLM_SCENARIO). Turn n is played when the conversation holds n model messages. '$item:<words>' becomes the item id that resolve_item returned for those words. See docs/runbook.md, 'Scripted fake model'. 'scripts' holds one script per task (the first whose matchTask matches); 'classify' scripts the safety classifier for new items (ADR-0028). The school-project script takes its new item's name from the task ({{kit}}), so every run makes a new item (e2e/unique.ts).",
  "turns": [
    {
      "toolCalls": [
        {
          "name": "ask_user",
          "args": {
            "question": "Which of these do you need?",
            "options": ["chai patti", "doodh", "adrak", "elaichi"],
            "multiSelect": true,
            "preselected": [0, 1]
          }
        }
      ]
    },
    {
      "toolCalls": [
        { "name": "resolve_item", "args": { "text": "chai patti" } },
        { "name": "resolve_item", "args": { "text": "adrak" } },
        { "name": "resolve_item", "args": { "text": "doodh" } }
      ]
    },
    {
      "toolCalls": [
        { "name": "find_item_nearby", "args": { "itemId": "$item:chai patti" } },
        { "name": "find_item_nearby", "args": { "itemId": "$item:adrak" } },
        { "name": "find_item_nearby", "args": { "itemId": "$item:doodh" } }
      ]
    },
    {
      "toolCalls": [
        { "name": "ask_shops", "args": { "itemId": "$item:chai patti" } },
        { "name": "ask_shops", "args": { "itemId": "$item:adrak" } },
        { "name": "ask_shops", "args": { "itemId": "$item:doodh" } }
      ]
    },
    {
      "toolCalls": [
        {
          "name": "submit_plan",
          "args": {
            "items": [
              { "text": "chai patti", "itemId": "$item:chai patti", "status": "confirmed" },
              { "text": "adrak", "itemId": "$item:adrak", "status": "confirmed" },
              { "text": "doodh", "itemId": "$item:doodh", "status": "confirmed" }
            ],
            "notes": "Chai ka saaman mil gaya."
          }
        }
      ]
    }
  ],
  "scripts": [
