              "args": {
                "items": [
                  { "text": "{{kit}}", "itemId": "$item:{{kit}}", "status": "confirmed" },
                  { "text": "chart paper", "itemId": "$item:chart paper", "status": "confirmed" },
                  { "text": "crayons", "itemId": "$item:crayons", "status": "confirmed" },
