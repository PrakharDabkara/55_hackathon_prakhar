# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Only 'simulated' exists: no SMS, the code is read at GET /dev/otp-inbox?phone=...
OTP_MODE=simulated
# Lowest trigram similarity that still counts as a match (0.3 to 1)
TRIGRAM_THRESHOLD=0.4
# A request is ANSWERED at once when this many shops already have the item; otherwise shops are pinged
MIN_STOCK_RESULTS=3
REQUEST_TTL_MINUTES=15
# Shops asked per request (nearest first), and the quiet period before the same shop is asked about the same item
MAX_PINGS_PER_REQUEST=10
PING_DEDUPE_MINUTES=30
# Run the request-expiry worker inside the API (needs REDIS_URL)
WORKERS_ENABLED=true
# Phones (comma-separated) that become admin on login: needed for the shop simulator.
# Empty = no admin, and every admin endpoint answers 404. Use a number that is not a real shop's.
ADMIN_PHONES=
# AI (ADR-0020). 'fake' answers locally with no network and no key; 'gemini' uses Google's free tier.
# Production must set this explicitly. Free-tier prompts may be reviewed by Google, so only query
# text and catalog item names are ever sent.
LLM_PROVIDER=fake
# With the fake provider, play the scripted errand model from a file (end-to-end runs; see the runbook)
# FAKE_LLM_SCENARIO=e2e/errand-scenario.json
# Needed when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
# Names come from `npm run ai:models`, which lists what your key can use.
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried after a timeout, 429 or 503 from the primary (blank: none). ADR-0024.
GEMINI_FALLBACK_MODEL=
# The errand agent's own models (blank: it uses GEMINI_MODEL and GEMINI_FALLBACK_MODEL). Query
# resolution never reads these. ADR-0027.
GEMINI_ERRAND_MODEL=
GEMINI_ERRAND_FALLBACK_MODEL=
GEMINI_EMBED_MODEL=gemini-embedding-001
# Size of items.embedding (migration 008); changing it needs a new migration.
EMBED_DIM=768
# An embedding answers when the best item is at least this similar (cosine) and this far ahead of
# the second best. Tuned on evals/resolve.dev.jsonl (npm run eval:resolve).
EMBED_THRESHOLD=0.7
EMBED_MARGIN=0.04
# Most photo data Postgres may hold, in MB (Neon free is 0.5 GB for everything). ADR-0030.
PHOTO_STORAGE_CAP_MB=300
# GIT_SHA=  (leave unset locally; shown by /health)

# docker-compose.yml reads these
POSTGRES_USER=kahanmilega
POSTGRES_PASSWORD=kahanmilega
POSTGRES_DB=kahanmilega
POSTGRES_PORT=5433
REDIS_PORT=6379

# Errand agent guardrails (ADR-0024): items per errand, model calls, tokens per errand,
# errands per user per hour, task length in characters
ERRAND_MAX_ITEMS=10
ERRAND_MAX_STEPS=8
ERRAND_TOKEN_BUDGET=20000
ERRAND_USER_HOURLY_LIMIT=5
ERRAND_TASK_MAX_CHARS=500
# Time limit of one errand model call in ms (resolve calls keep 8 s)
ERRAND_AI_TIMEOUT_MS=30000
# Asking shops, waiting, asking the user (ADR-0024 amendment): shop requests and questions per
# errand; resume after (ms); total wait cap (ms); unanswered question gives up (ms); overall
# life (ms); debounce for a burst of answers (ms)
ERRAND_MAX_ASK_SHOPS=6
ERRAND_MAX_QUESTIONS=2
ERRAND_RESUME_AFTER_MS=45000
ERRAND_MAX_WAIT_MS=300000
ERRAND_ANSWER_TIMEOUT_MS=600000
ERRAND_EXPIRY_MS=900000
ERRAND_RESUME_DEBOUNCE_MS=1000
# Plan optimiser (ADR-0025): the fewest-shops plan is recommended if it costs at most this many
# paise more than the cheapest plan (or at most 10 % more)
ERRAND_FEWER_STOPS_MAX_EXTRA_PAISE=3000

# Keep in step with the values above
DATABASE_URL=postgres://kahanmilega:kahanmilega@localhost:5433/kahanmilega
REDIS_URL=redis://localhost:6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MCP server (apps/mcp-server): which API it talks to (default: the live site), and where the saved login is
# KAHANMILEGA_API_URL=http://localhost:3000
# KAHANMILEGA_TOKEN_FILE=
