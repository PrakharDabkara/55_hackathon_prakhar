# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Only 'simulated' exists: no SMS, the code is read at GET /dev/otp-inbox?phone=...
OTP_MODE=simulated
# Lowest trigram similarity that still counts as a match (0.3 to 1)
TRIGRAM_THRESHOLD=0.4
# A request is ANSWERED at once when this many shops already have the item; otherwise shops are pinged
MIN_STOCK_RESULTS=3
REQUEST_TTL_MINUTES=15
# Shops asked per request (nearest first), and the quiet period before the same shop is asked about the same item
MAX_PINGS_PER_REQUEST=10
PING_DEDUPE_MINUTES=30
# Run the request-expiry worker inside the API (needs REDIS_URL)
WORKERS_ENABLED=true
# Phones (comma-separated) that become admin on login: needed for the shop simulator.
# Empty = no admin, and every admin endpoint answers 404. Use a number that is not a real shop's.
ADMIN_PHONES=
# AI (ADR-0020). 'fake' answers locally with no network and no key; 'gemini' uses Google's free tier.
# Production must set this explicitly. Free-tier prompts may be reviewed by Google, so only query
# text and catalog item names are ever sent.
LLM_PROVIDER=fake
# Needed when LLM_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
# Names come from `npm run ai:models`, which lists what your key can use.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Size of items.embedding (migration 008); changing it needs a new migration.
EMBED_DIM=768
# An embedding answers when the best item is at least this similar (cosine) and this far ahead of
# the second best. Tuned on evals/resolve.dev.jsonl (npm run eval:resolve).
EMBED_THRESHOLD=0.7
EMBED_MARGIN=0.04
# GIT_SHA=  (leave unset locally; shown by /health)

# docker-compose.yml reads these
POSTGRES_USER=kahanmilega
POSTGRES_PASSWORD=kahanmilega
POSTGRES_DB=kahanmilega
POSTGRES_PORT=5433
REDIS_PORT=6379

# Keep in step with the values above
DATABASE_URL=postgres://kahanmilega:kahanmilega@localhost:5433/kahanmilega
REDIS_URL=redis://localhost:6379

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
