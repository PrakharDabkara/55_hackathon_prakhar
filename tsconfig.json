{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@askbuy/shared": ["./packages/shared/src/index.ts"],
      "@askbuy/shared/tools": ["./packages/shared/src/tools/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts",
    "evals/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "apps/web/**"]
}
